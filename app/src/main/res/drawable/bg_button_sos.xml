<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30EF476F">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF16213E"
                android:centerColor="#FF1A1A2E"
                android:endColor="#FF0F0F17" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFEF476F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120%"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#30EF476F"
                android:endColor="#00EF476F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>