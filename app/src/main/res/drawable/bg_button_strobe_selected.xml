<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#60FFD166">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FFFFD166"
                android:endColor="#FFFFB347" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFE8A0" />
        </shape>
    </item>
</ripple>