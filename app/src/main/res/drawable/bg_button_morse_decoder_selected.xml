<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#6040E0D0">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF40E0D0"
                android:endColor="#FF32B8A8" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#FF80EAE0" />
        </shape>
    </item>
</ripple>