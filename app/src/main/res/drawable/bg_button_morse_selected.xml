<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#6020C2C8">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF20C2C8"
                android:endColor="#FF1B9E9E" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#FF66D9D9" />
        </shape>
    </item>
</ripple>