<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#6000FFAB">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF00FFAB"
                android:endColor="#FF00CC88" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#FF66FFCC" />
        </shape>
    </item>
</ripple>