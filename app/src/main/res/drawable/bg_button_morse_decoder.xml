<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3040E0D0">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF16213E"
                android:centerColor="#FF1A1A2E"
                android:endColor="#FF0F0F17" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FF40E0D0" />
        </shape>
    </item>
</ripple>