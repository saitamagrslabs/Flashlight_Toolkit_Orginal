<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000D4FF">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80%"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#FF1A1A2E"
                android:centerColor="#FF16213E"
                android:endColor="#FF0F0F17" />
            <stroke
                android:width="2dp"
                android:color="#FF00D4FF" />
        </shape>
    </item>
</ripple>