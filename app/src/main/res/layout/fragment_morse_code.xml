<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fn_bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/adView"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Compact Header (No decorative icon above title) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Morse Code"
                    android:textColor="@color/fn_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Encode • Decode • Transmit"
                    android:textColor="@color/fn_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Mode Selector Switcher -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btn_mode_sender">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_sender"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Send Morse"
                    android:textColor="@color/fn_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/fn_border_subtle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_receiver"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Receive Morse"
                    android:textColor="@color/fn_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/fn_border_subtle" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ================= SENDER SECTION ================= -->
            <LinearLayout
                android:id="@+id/container_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Transmission Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/fn_surface_level_1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fn_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/iv_status"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_power_off"
                            app:tint="@color/fn_text_secondary" />

                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Ready to transmit"
                            android:textColor="@color/fn_text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/fn_accent_red"
                            android:text="STOP"
                            android:textColor="@color/fn_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            android:visibility="gone" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Custom Message Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/fn_surface_level_1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fn_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✍️ Custom Message"
                            android:textColor="@color/fn_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="10dp"
                            android:text="Protocol Frame: Preamble + Message"
                            android:textColor="@color/fn_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Type message (e.g. SOS)"
                            app:boxBackgroundMode="outline"
                            app:boxBackgroundColor="@color/fn_surface_level_2"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/fn_primary_blue"
                            app:hintTextColor="@color/fn_text_secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_custom_message"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="3"
                                android:text="SOS"
                                android:textColor="@color/fn_text_primary"
                                android:textColorHint="@color/fn_text_secondary" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Morse Code Preview Sub-Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:cardBackgroundColor="@color/fn_surface_level_2"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/fn_border_subtle"
                            app:strokeWidth="1dp">

                            <TextView
                                android:id="@+id/tv_morse_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:padding="10dp"
                                android:text="Morse code will appear here"
                                android:textColor="@color/fn_accent_green"
                                android:textSize="12sp" />

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_send_custom"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="@color/fn_primary_blue"
                            android:text="FLASH MESSAGE"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Emergency Signals Presets Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/fn_surface_level_1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fn_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="🚨 Emergency Signals"
                            android:textColor="@color/fn_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <GridLayout
                            android:id="@+id/grid_emergency_signals"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ================= RECEIVER SECTION ================= -->
            <LinearLayout
                android:id="@+id/container_receiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 1. CAMERA PREVIEW VIEWFINDER CARD (FIRST IN RECEIVER) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#000000"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fn_border_subtle"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.camera.view.PreviewView
                            android:id="@+id/view_finder_receiver"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Target Reticle Overlay -->
                        <View
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_camera_reticle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="8dp"
                            android:background="@color/fn_surface_level_2"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Point camera at light source"
                            android:textColor="@color/fn_text_primary"
                            android:textSize="12sp" />

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 2. RECEIVER STATUS & START RECEIVER ACTION CARD (DIRECTLY BELOW CAMERA) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/fn_surface_level_1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fn_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Receiver Status"
                                android:textColor="@color/fn_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_receiver_sync"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting for preamble ('...')"
                                android:textColor="@color/fn_accent_red"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Primary Action Button: START RECEIVER -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_toggle_receiver"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="@color/fn_accent_green"
                            android:text="START RECEIVER"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 3. DECODED MESSAGE & DIAGNOSTICS CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/fn_surface_level_1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fn_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Primary Result: Decoded Text -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Decoded Message"
                            android:textColor="@color/fn_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:cardBackgroundColor="@color/fn_surface_level_2"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/fn_border_subtle"
                            app:strokeWidth="1dp">

                            <TextView
                                android:id="@+id/tv_decoded_message"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:text="[Decoded text will appear here]"
                                android:textColor="@color/fn_accent_green"
                                android:textSize="17sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Action Button: Clear Decoded Text -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset_receiver"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="CLEAR DECODED TEXT"
                            android:textColor="@color/fn_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/fn_border_subtle" />

                        <!-- Secondary Info: Detected Symbols -->
                        <TextView
                            android:id="@+id/tv_detected_symbols"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="monospace"
                            android:text="Current Symbols: -"
                            android:textColor="@color/fn_primary_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Diagnostic Info: Luma & Debug -->
                        <TextView
                            android:id="@+id/tv_luma_metrics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="Luma: 0.0 | Thresh: 0.0 | Light: OFF"
                            android:textColor="@color/fn_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_receiver_debug"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="Debug: Receiver ready"
                            android:textColor="@color/fn_text_tertiary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Quick Protocol Guide Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/fn_surface_level_1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fn_border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="📚 Quick Protocol Guide"
                        android:textColor="@color/fn_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="• Base Unit T = 150 ms\n• Dot = 1T (150ms), Dash = 3T (450ms)\n• Symbol Gap = 1T, Letter Gap = 3T, Word Gap = 7T, End Gap = 10T\n• Preamble Frame Sync = '...' (ON 1T, OFF 1T, ON 1T, OFF 1T, ON 1T, OFF 3T)"
                        android:textColor="@color/fn_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        ads:adSize="BANNER"
        ads:adUnitId="@string/morse_screen_banner_ad" />

</RelativeLayout>