<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_light_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Touch surface to hide/show controls on tap -->
    <View
        android:id="@+id/touch_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fixed Compact Non-Scrolling Bottom Sheet Panel (Fits <= 50% Screen Height) -->
    <LinearLayout
        android:id="@+id/bottom_sheet_layout"
        style="@style/Widget.MaterialComponents.BottomSheet.Modal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/fnSurfaceLevel1"
        android:orientation="vertical"
        android:paddingBottom="6dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Compact Drag Handle View -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="0dp"
            app:tint="?attr/fnTextTertiary" />

        <!-- Fixed Compact Control Panel (NO SCROLL VIEW) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="2dp">

            <!-- Banner Ad -->
            <com.google.android.gms.ads.AdView
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                ads:adSize="BANNER"
                ads:adUnitId="@string/screen_light_banner_ad" />

            <!-- Brightness Control Section (Compact Horizontal Row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_bottom_sheet_section"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/tv_brightness_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brightness"
                    android:textColor="?attr/fnTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_brightness_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:minWidth="32dp"
                    android:gravity="center"
                    android:contentDescription="Brightness percentage"
                    android:text="100%"
                    android:textColor="?attr/fnTextSecondary"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekbar_brightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Adjust Screen Light Brightness"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="?attr/fnPrimaryBlue"
                    android:thumbTint="?attr/fnPrimaryBlue" />
            </LinearLayout>

            <!-- Color Picker Section (Compact Horizontal Row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_bottom_sheet_section"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="Colors"
                    android:textColor="?attr/fnTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/color_palette"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Speed & Mode Status Section (Compact Horizontal Row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_bottom_sheet_section"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/tv_mode_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Mode: Solid"
                    android:textColor="?attr/fnTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/speed_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="Speed:"
                        android:textColor="?attr/fnTextSecondary"
                        android:textSize="10sp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/speed_toggle_group"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        app:checkedButton="@id/btn_speed_normal"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_speed_slow"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:contentDescription="Slow pattern speed"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="36dp"
                            android:paddingHorizontal="3dp"
                            android:paddingVertical="0dp"
                            android:text="Slow"
                            android:textColor="?attr/fnTextPrimary"
                            app:strokeColor="?attr/fnBorderSubtle"
                            android:textSize="9sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_speed_normal"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:contentDescription="Normal pattern speed"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="40dp"
                            android:paddingHorizontal="3dp"
                            android:paddingVertical="0dp"
                            android:text="Norm"
                            android:textColor="?attr/fnTextPrimary"
                            app:strokeColor="?attr/fnBorderSubtle"
                            android:textSize="9sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_speed_fast"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:contentDescription="Fast pattern speed"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="36dp"
                            android:paddingHorizontal="3dp"
                            android:paddingVertical="0dp"
                            android:text="Fast"
                            android:textColor="?attr/fnTextPrimary"
                            app:strokeColor="?attr/fnBorderSubtle"
                            android:textSize="9sp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- Patterns Section (2-column compact horizontal grid) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_police_pattern"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:contentDescription="Police pattern"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/selector_button_sos"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_police" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Police"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_party_pattern"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:contentDescription="Party pattern"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/selector_button_patterns"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_party" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Party"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_strobe_pattern"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:contentDescription="Strobe pattern"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/selector_button_strobe"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_strobe" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Strobe"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_candle_pattern"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:contentDescription="Candle pattern"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/selector_button_light_bulb"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_candle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Candle"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <!-- Clap Detection Section (Compact Horizontal Row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_bottom_sheet_section"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clap to Toggle Screen"
                    android:textColor="?attr/fnTextPrimary"
                    android:textSize="11sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/clap_switch_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:contentDescription="Clap to toggle screen light" />
            </LinearLayout>

            <!-- Compact Modern Back Button (Inset-Aware & >= 48dp Touch Height) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_custom"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:contentDescription="Back"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:text="Back"
                android:textColor="?attr/fnTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="?attr/fnSurfaceLevel2"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_back"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="?attr/fnTextPrimary"
                app:strokeColor="?attr/fnBorderSubtle"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>