<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/light_bulb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fn_bg_dark">

    <!-- FULL SCREEN MULTI-LAYER HYBRID LIGHT ENVIRONMENT CONTAINER -->
    <FrameLayout
        android:id="@+id/container_light_display"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- LAYER E: TYPE-SPECIFIC ENVIRONMENTAL ILLUMINATION BEAM & SPILL LAYERS -->
        <View
            android:id="@+id/view_env_standard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_env_standard"
            android:visibility="gone" />

        <View
            android:id="@+id/view_env_tube"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_env_tube"
            android:visibility="gone" />

        <View
            android:id="@+id/view_env_spotlight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_env_spotlight"
            android:visibility="gone" />

        <View
            android:id="@+id/view_env_torch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_env_torch"
            android:visibility="gone" />

        <View
            android:id="@+id/view_env_edison"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_env_edison"
            android:visibility="gone" />

        <View
            android:id="@+id/view_env_smart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_env_smart"
            android:visibility="gone" />

        <View
            android:id="@+id/view_env_candle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_env_candle"
            android:visibility="gone" />

        <!-- LAYER B: REALISTIC TRANSPARENT LIGHT-SOURCE BODY ASSET -->
        <ImageView
            android:id="@+id/iv_bulb_illustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="Selected Light Source Visual"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/img_bulb_standard" />

        <!-- LAYER C & D: TYPE-SPECIFIC INTERNAL EMITTER & EMISSION BLOOM LAYERS -->
        <View
            android:id="@+id/view_emitter_standard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_emitter_standard"
            android:visibility="gone" />

        <View
            android:id="@+id/view_emitter_tube"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_emitter_tube"
            android:visibility="gone" />

        <View
            android:id="@+id/view_emitter_spotlight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_emitter_spotlight"
            android:visibility="gone" />

        <View
            android:id="@+id/view_emitter_torch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_emitter_torch"
            android:visibility="gone" />

        <View
            android:id="@+id/view_emitter_edison"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_emitter_edison"
            android:visibility="gone" />

        <View
            android:id="@+id/view_emitter_smart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_emitter_smart"
            android:visibility="gone" />

        <View
            android:id="@+id/view_emitter_candle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glow_emitter_candle"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Top Floating Header Bar -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- Top-Left Floating Back Button -->
        <ImageButton
            android:id="@+id/btn_back_light_bulb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_overlay_circle"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/fnTextPrimary" />

        <!-- Center Screen Title Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_overlay_pill"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Light Bulb"
                android:textColor="?attr/fnTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ambient Light Control"
                android:textColor="?attr/fnTextSecondary"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Top-Right Floating Selector Button -->
        <ImageButton
            android:id="@+id/btn_select_bulb_type"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_overlay_circle"
            android:contentDescription="Select Light Source Type"
            android:padding="12dp"
            android:src="@drawable/ic_lightbulb"
            app:tint="?attr/fnTextPrimary" />

    </RelativeLayout>

    <!-- Brightness & Gesture Navigation HUD Popup Text -->
    <TextView
        android:id="@+id/tv_brightness_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_overlay_pill"
        android:elevation="6dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="100%"
        android:textColor="?attr/fnTextPrimary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom Overlay Information & Gesture Indicator Pill -->
    <LinearLayout
        android:id="@+id/bottom_info_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_overlay_pill"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tv_overlay_bulb_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standard Bulb"
            android:textColor="?attr/fnTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_overlay_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Swipe ↕ for brightness • ↔ to change bulb"
            android:textColor="?attr/fnTextSecondary"
            android:textSize="12sp" />

    </LinearLayout>

</RelativeLayout>
