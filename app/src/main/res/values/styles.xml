<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================= -->
    <!-- FlashNow Typography Hierarchy Tokens                              -->
    <!-- ================================================================= -->
    <style name="FlashNow.Text.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fnTextPrimary</item>
    </style>

    <style name="FlashNow.Text.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fnTextPrimary</item>
    </style>

    <style name="FlashNow.Text.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fnTextPrimary</item>
    </style>

    <style name="FlashNow.Text.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fnTextPrimary</item>
    </style>

    <style name="FlashNow.Text.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/fnTextSecondary</item>
    </style>

    <style name="FlashNow.Text.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/fnTextSecondary</item>
    </style>

    <style name="FlashNow.Text.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/fnTextTertiary</item>
    </style>

    <!-- ================================================================= -->
    <!-- FlashNow Component Foundation Styles                             -->
    <!-- ================================================================= -->

    <!-- Card Standard Style -->
    <style name="FlashNow.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/fnSurfaceLevel1</item>
        <item name="cardCornerRadius">@dimen/fn_card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/fnBorderSubtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Card Elevated / Interactive Style -->
    <style name="FlashNow.Card.Elevated">
        <item name="cardBackgroundColor">?attr/fnSurfaceLevel2</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Primary Pill Button Style -->
    <style name="FlashNow.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/fnPrimaryBlue</item>
        <item name="android:textColor">?attr/fnBackground</item>
        <item name="cornerRadius">@dimen/fn_button_corner_radius_pill</item>
        <item name="android:minHeight">@dimen/fn_touch_target_min</item>
    </style>

    <!-- Secondary Outlined Button Style -->
    <style name="FlashNow.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">?attr/fnBorderSubtle</item>
        <item name="android:textColor">?attr/fnTextPrimary</item>
        <item name="cornerRadius">@dimen/fn_card_corner_radius_compact</item>
        <item name="android:minHeight">@dimen/fn_touch_target_min</item>
    </style>

    <!-- Switch Style -->
    <style name="FlashNow.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">?attr/fnAccentGreen</item>
    </style>

    <!-- Bottom Sheet Foundation Style -->
    <style name="FlashNow.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">?attr/fnSurfaceLevel1</item>
    </style>

</resources>
