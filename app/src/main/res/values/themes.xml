<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FlashNow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Window Baseline Colors -->
        <item name="android:windowBackground">@color/fn_bg_dark</item>
        <item name="android:colorBackground">@color/fn_bg_dark</item>
        <item name="colorSurface">@color/fn_surface_level_1</item>
        <item name="colorPrimary">@color/fn_primary_blue</item>
        <item name="colorSecondary">@color/fn_accent_amber</item>

        <!-- Set custom toolbar style by default -->
        <item name="toolbarStyle">@style/App.Toolbar</item>

        <!-- Set status bar & navigation bar colors -->
        <item name="android:statusBarColor">@color/fn_bg_dark</item>
        <item name="android:navigationBarColor">@color/fn_bg_dark</item>

        <!-- Ensure light text/icons on dark status bar -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Use the correct theme attribute for MaterialToolbar's popup -->
        <item name="popupTheme">@style/App.PopupMenuTheme</item>
    </style>

    <style name="Theme.FlashNow" parent="Base.Theme.FlashNow" />

    <!-- 1. Custom WIDGET style for the Toolbar's layout -->
    <style name="App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/fn_bg_dark</item>
    </style>

    <!-- 2. Custom THEME OVERLAY for the Toolbar's colors -->
    <style name="App.Toolbar.Theme" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="colorControlNormal">@color/fn_primary_blue</item>
        <item name="titleTextColor">@color/fn_primary_blue</item>
    </style>

    <!-- A Theme Overlay for the Popup Menu -->
    <style name="App.PopupMenuTheme" parent="ThemeOverlay.Material3.Dark">
        <item name="colorSurface">@color/fn_surface_level_1</item>
    </style>

</resources>